#!/bin/bash
#SBATCH -p gpu --gres=gpu:1 -c 4 --mem=24G -t 08:00:00 -x gpu01,gpu04,gpu08,gpu09,gpu10,gpu11,gpu12,gpu25,node08 --constraint="RTX3080|RTX2080Ti" -J ljdft -o ${HOME}/runs/training/omol_universal/mlmm_ft/residues/ljfit/logs/dft.%A_%a.out
cd ${HOME}/runs/training/omol_universal/mlmm_ft/residues/ljfit
nvidia-smi --query-gpu=name --format=csv,noheader
export CUDA_PATH=${HOME}/envs/g4p/cuda PYTHONNOUSERSITE=1 LD_LIBRARY_PATH=${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cublas/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cufft/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/curand/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cusolver/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cusparse/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/nvjitlink/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/cutensor/lib LIBRARY_PATH=${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cublas/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cufft/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/curand/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cusolver/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/cusparse/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/nvidia/nvjitlink/lib:${HOME}/envs/g4p/lib/python3.12/site-packages/cutensor/lib
${HOME}/envs/g4p/bin/python dft_dimers.py ${DIM:-dimers.json} ${SLURM_ARRAY_TASK_ID:-0} ${NT:-1} ${OUTD:-out}
