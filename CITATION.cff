cff-version: 1.2.0
message: "If you use karml, please cite it as below (and the associated paper once published)."
title: "karml"
type: software
abstract: >-
  karml (pronounced Karamell) combines CHARMM MLpot and JAX-MD with JAX-based neural models (PhysNet, DCMNet and others)
  for hybrid machine-learned/molecular-mechanics (ML/MM) condensed-phase simulations.
authors:
  - family-names: Boittier
    given-names: "Eric D."
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # TODO(author): ORCID iD
  # TODO(author): further software authors and ORCID iDs go here, in the intended order (not invented here).
repository-code: "https://github.com/EricBoittier/karml"
url: "https://github.com/EricBoittier/karml"
license: MIT
keywords:
  - molecular dynamics
  - machine-learned potentials
  - ML/MM
  - JAX
